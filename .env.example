# Copy this file to .env.local and fill in the real values.
# These variables are intended for server-side access to ClickHouse.

CLICKHOUSE_PROTOCOL=http
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# View used for shipment data in the client portal.
CLICKHOUSE_VIEW=vw_Embarques_pc
CLICKHOUSE_TRACKING_TABLE=ContainerTrackingDaily
CLICKHOUSE_PORTAL_USERS_TABLE=PortalClientes.PortalClientUsers
AUTH_JWT_SECRET=change-this-secret-with-at-least-32-characters
AUTH_SESSION_TTL_MINUTES=480

# Secure shipment documents API used by the portal documents panel.
DOCUMENTS_API_BASE_URL=http://192.168.6.190:1313
DOCUMENTS_API_USERNAME=
DOCUMENTS_API_PASSWORD=
DOCUMENTS_API_TIMEOUT_MS=15000
DOCUMENTS_API_TOKEN_TTL_MS=1200000

# Optional tuning for local development.
CLICKHOUSE_QUERY_LIMIT=500
CLICKHOUSE_TIMEOUT_MS=10000
CLICKHOUSE_DEFAULT_SEASON=