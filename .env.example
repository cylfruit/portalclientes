# Copy this file to .env.local and fill in the real values.
# These variables are intended for server-side access to ClickHouse.

CLICKHOUSE_PROTOCOL=http
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# View used for shipment data in the client portal.
CLICKHOUSE_VIEW=vw_Embarques_pc

# Optional tuning for local development.
CLICKHOUSE_QUERY_LIMIT=500
CLICKHOUSE_TIMEOUT_MS=10000
CLICKHOUSE_DEFAULT_SEASON=